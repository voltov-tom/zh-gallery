#!/bin/sh
# Разрешённые операции деплоя. Запускается только через /usr/local/bin/zhctl
# (forced command в authorized_keys) и sudo-правилом для пользователя deploy.
# Никакого eval и свободных аргументов: строгий разбор строки.
set -eu

CMD="${1:-}"
ROOT=/home/zhdocker/zh-gallery
# rootless-демон и окружение пользователя zhdocker (UID 988)
AS_ZH="sudo -u zhdocker env XDG_RUNTIME_DIR=/run/user/988 DOCKER_HOST=unix:///run/user/988/docker.sock HOME=/home/zhdocker"
COMPOSE="docker compose -f $ROOT/docker-compose.prod.yml"

case "$CMD" in
    status)
        cd "$ROOT"
        $AS_ZH $COMPOSE ps
        ;;

    "logs web")
        cd "$ROOT"
        $AS_ZH $COMPOSE logs --tail 100 web
        ;;

    deploy\ *)
        SHA="${CMD#deploy }"
        case "$SHA" in
            *[!0-9a-f]*)
                echo "ошибка: ожидается только 40 hex-символов sha" >&2
                exit 2
                ;;
        esac
        if [ "${#SHA}" -ne 40 ]; then
            echo "ошибка: sha должен быть длиной 40 символов" >&2
            exit 2
        fi

        cd "$ROOT"
        # синхронизация конфигов: только здесь, до запуска deploy.sh, чтобы
        # скрипт не перезаписывал сам себя во время выполнения
        $AS_ZH git -C src fetch -q origin refactor
        $AS_ZH git -C src reset -q --hard origin/refactor
        $AS_ZH cp -f src/deploy/docker-compose.prod.yml \
                     src/deploy/nginx-prod.conf src/deploy/maintenance.html .
        $AS_ZH cp -f src/deploy/deploy.sh ./deploy.sh.new
        $AS_ZH mv -f ./deploy.sh.new ./deploy.sh
        $AS_ZH chmod +x deploy.sh
        exec $AS_ZH env IMAGE_TAG="$SHA" ./deploy.sh
        ;;

    *)
        echo "команда не разрешена" >&2
        exit 1
        ;;
esac
