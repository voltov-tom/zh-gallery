# --- Django ---------------------------------------------------------------
# SECRET_KEY обязателен в production (settings/production.py не стартует без него).
# Сгенерировать: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me-in-production
DEBUG=False
# Для проверки с телефона в той же Wi-Fi добавьте IP компьютера, например:
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.106
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Через запятую, со схемой: https://zh-gallery.ru,https://www.zh-gallery.ru
# И тот же адрес в CSRF_TRUSTED_ORIGINS, иначе формы с телефона получат 403:
# CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://192.168.1.106:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080
# Домен для абсолютных ссылок в письмах (allauth/django.contrib.sites)
SITE_DOMAIN=localhost:8080
SITE_NAME=zh-gallery
# Включать только когда сайт реально работает по https
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# --- База данных ----------------------------------------------------------
# Либо DATABASE_URL=postgres://user:pass@host:5432/db, либо SQL_* ниже.
DATABASE_URL=
SQL_ENGINE=django.db.backends.postgresql
SQL_DATABASE=zh_gallery
SQL_USER=zh_gallery
SQL_PASSWORD=zh_gallery
SQL_HOST=db
SQL_PORT=5432
SQL_CONN_MAX_AGE=60

# --- Кэш и сессии ---------------------------------------------------------
# Пусто — сессии в БД и локальный кэш (режим «без Redis»).
REDIS_URL=redis://redis:6379/1

# --- Медиа ----------------------------------------------------------------
# local — файлы на диске (том media), nextcloud — WebDAV-хранилище.
MEDIA_STORAGE=local
MEDIA_URL=/media/
# MEDIA_ROOT=/app/zh_gallery/media

# Для MEDIA_STORAGE=nextcloud (старые имена WEBDAV_* тоже поддерживаются):
# HOSTNAME — либо домен (https://cloud.example.com), либо полный адрес WebDAV
# (https://cloud.example.com/remote.php/dav/files/<user>/). Второй вариант — как
# в старом .env проекта: тогда логин подставляется только в Basic Auth.
NEXTCLOUD_HOSTNAME=
NEXTCLOUD_LOGIN=
NEXTCLOUD_PASSWORD=
NEXTCLOUD_ROOT=zh-gallery
# Публичный префикс ссылок на файлы; пусто — используется MEDIA_URL
NEXTCLOUD_PUBLIC_URL=
# Полный адрес WebDAV-корня, если HOSTNAME — только домен (обычно не нужен):
NEXTCLOUD_BASE_URL=
# Конфиг nginx: ./docker/nginx.conf (локальные файлы) или
# ./docker/nginx-nextcloud.conf (медиа в Nextcloud, отдаёт Django)
NGINX_CONF=./docker/nginx.conf
NEXTCLOUD_TIMEOUT=30

# Локальный кэш картинок: при недоступном Nextcloud файлы отдаются с диска.
# По умолчанию включён только для MEDIA_STORAGE=nextcloud.
MEDIA_CACHE_ENABLED=True
# MEDIA_CACHE_ROOT=/app/zh_gallery/media-cache

# --- Почта ----------------------------------------------------------------
# По умолчанию письма печатаются в лог контейнера: docker compose logs -f web
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Хотите смотреть письма в веб-интерфейсе Mailpit (:8025)? Тогда раскомментируйте
# строки ниже и запустите его: docker compose --profile mail up -d mailpit
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=mailpit
# EMAIL_PORT=1025
EMAIL_HOST=
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=False
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=zh-gallery@example.com
EMAIL_CONFIRMATION_COOLDOWN=60

# --- Соцвход (django-allauth: ВКонтакте и Mail.ru) -------------------------
# Вариант 1: ключи здесь (кабинет VK ID / Mail.ru для разработчиков).
# Вариант 2: завести Social application в админке Django — allauth поймёт оба.
# Без ключей кнопки входа просто не показываются.
VK_CLIENT_ID=
VK_SECRET=
MAILRU_CLIENT_ID=
MAILRU_SECRET=

# --- Telegram-бот ---------------------------------------------------------
# Если задан, эндпоинты /api/telegram_bot/... требуют заголовок X-Bot-Token.
# Без токена API бота выключено (иначе любой GET накручивает просмотры):
# запросы должны присылать заголовок X-Bot-Token с этим токеном.
TELEGRAM_BOT_TOKEN=

# --- Прочее ---------------------------------------------------------------
LOG_LEVEL=INFO
