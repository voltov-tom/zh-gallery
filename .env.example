# --- Django ---------------------------------------------------------------
# SECRET_KEY обязателен в production (settings/production.py не стартует без него).
# Сгенерировать: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me-in-production
DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Через запятую, со схемой: https://zh-gallery.ru,https://www.zh-gallery.ru
CSRF_TRUSTED_ORIGINS=http://localhost:8080
# Домен для абсолютных ссылок в письмах (allauth/django.contrib.sites)
SITE_DOMAIN=localhost:8080
SITE_NAME=zh-gallery
# Включать только когда сайт реально работает по https
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# --- База данных ----------------------------------------------------------
# Либо DATABASE_URL=postgres://user:pass@host:5432/db, либо SQL_* ниже.
DATABASE_URL=
SQL_ENGINE=django.db.backends.postgresql
SQL_DATABASE=zh_gallery
SQL_USER=zh_gallery
SQL_PASSWORD=zh_gallery
SQL_HOST=db
SQL_PORT=5432
SQL_CONN_MAX_AGE=60

# --- Кэш и сессии ---------------------------------------------------------
# Пусто — сессии в БД и локальный кэш (режим «без Redis»).
REDIS_URL=redis://redis:6379/1

# --- Медиа ----------------------------------------------------------------
# local — файлы на диске (том media), nextcloud — WebDAV-хранилище.
MEDIA_STORAGE=local
MEDIA_URL=/media/
# MEDIA_ROOT=/app/zh_gallery/media

# Для MEDIA_STORAGE=nextcloud (старые имена WEBDAV_* тоже поддерживаются)
NEXTCLOUD_HOSTNAME=
NEXTCLOUD_LOGIN=
NEXTCLOUD_PASSWORD=
NEXTCLOUD_ROOT=zh-gallery
# Публичный префикс ссылок на файлы; пусто — используется MEDIA_URL
NEXTCLOUD_PUBLIC_URL=
NEXTCLOUD_TIMEOUT=30

# --- Почта ----------------------------------------------------------------
# В docker-compose локально письма складываются в Mailpit (http://localhost:8025)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=False
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=zh-gallery@example.com
EMAIL_CONFIRMATION_COOLDOWN=60

# --- Соцвход (django-allauth, Google) -------------------------------------
# Ключи выдаются в Google Cloud Console; без них вход через Google просто скрыт.
OAUTH2_GOOGLE=
OAUTH2_GOOGLE_SECRET=

# --- Telegram-бот ---------------------------------------------------------
# Если задан, эндпоинты /api/telegram_bot/... требуют заголовок X-Bot-Token.
TELEGRAM_BOT_TOKEN=

# --- Прочее ---------------------------------------------------------------
LOG_LEVEL=INFO
